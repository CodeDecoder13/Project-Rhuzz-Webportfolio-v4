APP_NAME=Rhuzz Web Portfolio
NODE_ENV=development

# Database (Postgres)
DATABASE_URL=

# Admin / blog (ADMIN_SEED_PIN must be exactly 6 digits)
ADMIN_EMAIL=
ADMIN_SEED_PIN=
ADMIN_SESSION_SECRET=

# Mail (Resend)
RESEND_API_KEY=
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# AI chat (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Object storage for blog photos (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SEO
GOOGLE_SITE_VERIFICATION=

# Optional: published CI run summary for the Proof section
# TEST_REPORT_URL=https://codedecoder13.github.io/Project-Rhuzz-Webportfolio-v4/summary.json
